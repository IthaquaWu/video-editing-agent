# =============================================================================
# 备选方案：使用 OpenAI GPT-4o Vision（如果不使用 Wan-AI）
# =============================================================================
# API_KEY=your-api-key-here
# API_BASE_URL=https://openrouter.ai/api/v1
# VISION_MODEL=gpt-4o
# =============================================================================
# Wan-AI 视频模型配置（推荐）
# =============================================================================
# # Wan-AI API 密钥（从 https://wan-ai.com 获取）
# API_KEY=your-api-key-here

# # Wan-AI API 基础 URL
# API_BASE_URL=https://api.wan-ai.com/v1

# # Wan-AI 视频理解模型
# VISION_MODEL=Wan-AI/Wan2.2-I2V-A14B

# =============================================================================
# 备选方案：使用 OpenAI GPT-4o Vision（如果不使用 Wan-AI）
# =============================================================================
# API_KEY=your-api-key-here
# API_BASE_URL=https://api.openai.com/v1
# VISION_MODEL=gpt-4o

# =============================================================================
# 备选方案：使用 Gemini Vision（如果不使用 Wan-AI）
# =============================================================================
# API_KEY=your-google-api-key
# VISION_MODEL=gemini-1.5-pro-vision

# =============================================================================
# 工具路径配置
# =============================================================================
# Blender 路径（如果已添加到系统 PATH，可留空）
# Windows 示例：
# BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 5.0\blender.exe
# macOS 示例：
# BLENDER_PATH=/Applications/Blender.app/Contents/MacOS/Blender
# Linux 示例：
# BLENDER_PATH=/usr/bin/blender

# FFmpeg 路径（如果已添加到系统 PATH，可留空）
# Windows 示例：
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# =============================================================================
# 工作空间配置
# =============================================================================
# 工作空间目录（用于存储临时文件和输出）
WORKSPACE_DIR=./workspace

# =============================================================================
# 场景分析配置
# =============================================================================
# 粗粒度扫描间隔（秒）- 第一步快速定位
COARSE_INTERVAL=10

# 精细粒度扫描间隔（秒）- 第二步精确定位
FINE_INTERVAL=1

# =============================================================================
# Render-Critique 配置
# =============================================================================
# 最大迭代次数（生成-渲染-评审循环）
MAX_ITERATIONS=3

# 预览分辨率百分比（1-100，越小渲染越快）
PREVIEW_RESOLUTION=50

# 质量通过阈值（1-10，评分达到此值才通过）
QUALITY_THRESHOLD=7.0

# =============================================================================
# Blender 渲染配置
# =============================================================================
# 默认帧率
DEFAULT_FPS=30

# 输出格式（FFMPEG 或 AVI_JPEG）
DEFAULT_FORMAT=FFMPEG

# 视频编码器（H264, MPEG4, AV1, etc.）
DEFAULT_CODEC=H264
